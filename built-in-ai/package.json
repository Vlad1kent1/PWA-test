{
  "name": "built-in-ai",
  "version": "1.0.0",
  "description": "Built-in AI demos",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "scripts": {
    "build": "node init && npm run build:playgrounds && npm run build:samples",
    "build:playgrounds": "node init &&  npx @11ty/eleventy --input=templates/playground-* --output=playgrounds",
    "build:samples": "node init &&  npx @11ty/eleventy --input=templates/sample-* --output=samples",
    "watch": "npm run watch:playgrounds & npm run watch:samples",
    "watch:playgrounds": "npx @11ty/eleventy --input=templates/playground-* --output=playgrounds --watch",
    "watch:samples": "npx @11ty/eleventy --input=templates/sample-* --output=samples --watch"
  }
}
